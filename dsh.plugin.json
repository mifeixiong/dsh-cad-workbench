{
  "id": "dsh-cad-workbench",
  "version": "0.4.0",
  "main": "index.js",
  "description": "Mechanical CAD workbench for DeepSeek Harness: declarative SolidWorks modelling with measured verification, reference-image alignment (calibration, metric grids, diff), adversarial review, and zone-scoped subagent dispatch.",
  "engines": {
    "dsh": ">=0.2.2-rc.1 <0.3.0"
  },
  "contributes": {
    "tools": [
      "cadw_doctor",
      "cadw_session",
      "cadw_model",
      "cadw_measure",
      "cadw_capture",
      "cadw_export",
      "cadw_drawing",
      "cadw_review",
      "cadw_job",
      "cadw_assembly",
      "cadw_ref",
      "cadw_grid",
      "cadw_diff",
      "cadw_audit",
      "cadw_dispatch"
    ],
    "skills": [
      "cad-modeling-workflow",
      "solidworks-com",
      "cad-feature-graph",
      "cad-drawing-gb",
      "cad-reference-match",
      "cad-adversarial-review"
    ]
  }
}
